# ---------------------------------------------------------------------------
# Monoceros — environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Monoceros

# --- Database --------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monoceros?schema=public
# Optional connection-pool ceiling. Leave unset for the driver default (10).
# Lower it for serverless platforms or a managed database with few connections.
# The zero-install preview database (npm run preview:db) requires 1.
DATABASE_POOL_MAX=

# --- Authentication --------------------------------------------------------
# 32+ random bytes. Generate with:  openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-secret-value-min-32-chars
# Session lifetime in hours (users). Admin sessions use ADMIN_SESSION_TTL_HOURS.
SESSION_TTL_HOURS=72
ADMIN_SESSION_TTL_HOURS=8
# Failed logins before a temporary lock, and the lock duration in minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Email -----------------------------------------------------------------
# Provider: console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Monoceros <no-reply@example.com>"
EMAIL_REPLY_TO=support@example.com

# Resend
RESEND_API_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Private document storage (KYC / payment proofs) -----------------------
# Driver: local | s3
STORAGE_DRIVER=local
# Local driver: directory OUTSIDE the public folder. Never served statically.
STORAGE_LOCAL_DIR=./.private-storage
# Max upload size in megabytes (also enforced as an admin setting).
UPLOAD_MAX_MB=8

# S3-compatible driver (AWS S3, Cloudflare R2, Backblaze B2, MinIO...)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Market data (public display only — never used in any calculation) -----
MARKET_API_BASE_URL=https://api.coingecko.com/api/v3
# Optional CoinGecko Demo/Pro key. Leave blank to use the free public tier.
COINGECKO_API_KEY=
MARKET_CACHE_SECONDS=60

# --- Scheduled jobs --------------------------------------------------------
# Shared secret required by POST /api/cron/run (send as Authorization: Bearer ...)
CRON_SECRET=replace-me-with-another-long-random-secret

# --- Administrator bootstrap (optional; used by `npm run admin:create`) ----
# Leave blank in production and create admins interactively instead.
ADMIN_ONE_EMAIL=
ADMIN_ONE_PASSWORD=
ADMIN_ONE_NAME=
ADMIN_TWO_EMAIL=
ADMIN_TWO_PASSWORD=
ADMIN_TWO_NAME=
